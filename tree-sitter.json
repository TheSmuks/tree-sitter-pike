{
  "grammars": [
    {
      "name": "pike",
      "scope": "source.pike",
      "file-types": ["pike", "pmod"],
      "injection-regex": "^pike$",
      "highlights": ["queries/highlights.scm"],
      "locals": ["queries/locals.scm"],
      "injections": ["queries/injections.scm"],
      "tags": ["queries/tags.scm"]
    }
  ],
  "metadata": {
    "version": "1.3.1",
    "license": "MIT",
    "description": "Pike grammar for tree-sitter",
    "authors": [
      { "name": "TheSmuks" }
    ],
    "links": {
      "repository": "https://github.com/TheSmuks/tree-sitter-pike"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
