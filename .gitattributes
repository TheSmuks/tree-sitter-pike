# Auto detect text files and perform LF normalization
* text=auto

# Source files
*.ts text eol=lf
*.js text eol=lf
*.c text eol=lf
*.h text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.so binary
*.dylib binary
*.dll binary

# tree-sitter generated files
grammar.js linguist-generated=true
grammar.json linguist-generated=true
src/parser.c linguist-generated=true
src/parser.h linguist-generated=true
src/grammar.json linguist-generated=true
src/node-types.json linguist-generated=true
src/tree_sitter/* linguist-generated=true

# Generated language bindings (exclude from GitHub language stats)
bindings/** linguist-generated=true
binding.gyp linguist-generated=true
CMakeLists.txt linguist-generated=true
Makefile linguist-generated=true
Cargo.toml linguist-generated=true
go.mod linguist-generated=true
Package.swift linguist-generated=true
setup.py linguist-generated=true
pyproject.toml linguist-generated=true

# Documentation
*.md text eol=lf
LICENSE text eol=lf